# Токен бота від @BotFather
BOT_TOKEN=123456:ABC-your-token
# Telegram ID адмінів через кому (дізнатися свій ID: @userinfobot)
ADMIN_IDS=111111111
# Посилання на ваш публічний ТГК (показується в меню)
CHANNEL_URL=https://t.me/your_channel
# Шлях до бази даних
DB_PATH=data/bot.db

# ---------- ОПЛАТА ----------
# Способи оплати через кому: stars (Telegram Stars) і/або manual (переказ на картку + підтвердження адміном)
PAYMENT_METHODS=stars,manual
# Валюта для ручної оплати (показується поруч із полем "price" у courses.json)
CURRENCY=грн
# Реквізити для ручної оплати. \n — новий рядок
PAYMENT_DETAILS=💳 Картка: 0000 0000 0000 0000\nОтримувач: Прізвище Ім'я\nПризначення: оплата курсу
